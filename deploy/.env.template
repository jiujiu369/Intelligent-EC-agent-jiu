# ============================================
# 复制本文件为 .env 并填入真实值（.env 不进仓库）
# ============================================

# 必填：你的 LLM API 密钥（从 config.py 的 base_url 对应服务商获取）
AGENT_API_KEY=sk-你的密钥

# 可选：以下在 config.py 中已有默认值，一般不用改
AGENT_BASE_URL=https://apihub.agnes-ai.com/v1
AGENT_MODEL_NAME=agnes-2.0-flash

# 云端无本地模型，运行时从 HuggingFace 自动下载
AGENT_RAG_EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
AGENT_RAG_FALLBACK_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
